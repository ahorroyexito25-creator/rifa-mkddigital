# Copia este archivo como ".env" para desarrollo local.
# En Render, estas mismas variables se configuran en el panel
# "Environment" del servicio (Settings → Environment Variables),
# NUNCA se sube este archivo al repositorio (ya está en .gitignore).

# Settings → API → Project URL (en tu proyecto de Supabase)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Settings → API → Project API keys → "service_role" (secreta)
# IMPORTANTE: usa la clave "service_role", NO la "anon public".
# La service_role tiene permisos completos y solo debe vivir en el backend.
SUPABASE_KEY=tu-clave-service-role-aqui
